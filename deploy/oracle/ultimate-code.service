# /etc/systemd/system/ultimate-code.service
# 安裝：sudo mkdir -p /var/lib/ultimate-code && sudo chown <服務帳號> /var/lib/ultimate-code
#       sudo cp deploy/oracle/ultimate-code.service /etc/systemd/system/ && sudo systemctl daemon-reload
#       sudo systemctl enable --now ultimate-code
[Unit]
Description=Ultimate Code game backend (WebSocket, SQLite room recovery)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<服務帳號>
WorkingDirectory=/opt/ultimate-code
EnvironmentFile=/opt/ultimate-code/deploy/oracle/server.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=2
# 房間快照所在目錄要可寫；其他目錄唯讀
ReadWritePaths=/var/lib/ultimate-code
ProtectSystem=strict
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
