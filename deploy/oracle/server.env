# ===== Oracle 東京 VM：終極密碼後端環境變數（systemd EnvironmentFile）=====
# 三級備援第一級。房間快照存在 VM 持久磁碟上的 SQLite，重啟後 120 秒內玩家可回到原房間。
# 埠與網域請依同台 VM 上其他遊戲的分配調整（guess-ab 用 3100、bomb-squad 另有服務）。
PORT=3110
UC_ROOM_DB_PATH=/var/lib/ultimate-code/rooms.db
GAME_ALLOWED_ORIGIN=https://pjh-eric.github.io
NODE_ENV=production
# 小記憶體 VM（E2.1.Micro）：限制 V8 年輕代，與其他遊戲共存時保留可用記憶體
NODE_OPTIONS=--max-semi-space-size=4
